{
  "supplement_A01_components": {
    "fields": [
      "Component label",
      "Component",
      "Status",
      "Implemented detail"
    ],
    "rows": [
      {
        "Component label": "A01",
        "Component": "Arithmetic problem and operand range",
        "Status": "Follows",
        "Implemented detail": "Reverse Polish expressions; 3–8 operands, each drawn from 1–9."
      },
      {
        "Component label": "A02",
        "Component": "Operator set and exact division",
        "Status": "Follows",
        "Implemented detail": "Addition, subtraction, multiplication, and nonzero exact-integer division."
      },
      {
        "Component label": "A03",
        "Component": "Expression proposal distribution",
        "Status": "Departs",
        "Implemented detail": "Uniform proposed operand counts, digits, and Catalan shapes; enumerate attainable results instead of sampling operator assignments."
      },
      {
        "Component label": "A04",
        "Component": "Attainable targets, ties, and duplicates",
        "Status": "Not Specified",
        "Implemented detail": "Uniform attainable in-range target; lexicographically first valid tuple in +,-,*,/ order; reject duplicate inputs."
      },
      {
        "Component label": "A05",
        "Component": "Multiset split",
        "Status": "Departs",
        "Implemented detail": "Salted SHA256 assigns separate train/ID/OOD multiset buckets of 80/10/10."
      },
      {
        "Component label": "A06",
        "Component": "Target ranges",
        "Status": "Follows",
        "Implemented detail": "Training and ID results 0–101; OOD results 102–201."
      },
      {
        "Component label": "A07",
        "Component": "Training and evaluation population sizes",
        "Status": "Not Specified",
        "Implemented detail": "Dataset sizes vary across the completed settings; the development population is fixed."
      },
      {
        "Component label": "A08",
        "Component": "Padded input and supervised positions",
        "Status": "Follows",
        "Implemented detail": "Padded input, maximum 19 tokens; final result appended; loss at masked operator positions only."
      },
      {
        "Component label": "A09",
        "Component": "Arithmetic tokenization",
        "Status": "Not Specified",
        "Implemented detail": "Vocabulary 13; pad 0, mask 11, separator 12; result encoded digit by digit; digit tokens offset by 1."
      },
      {
        "Component label": "A10",
        "Component": "Output head",
        "Status": "Not Specified",
        "Implemented detail": "Bias-free four-class operator head applied to high states; loss gathers masked positions."
      },
      {
        "Component label": "A11",
        "Component": "Backbone dimensions and sharing",
        "Status": "Follows",
        "Implemented detail": "One shared four-layer stack; hidden width 512; eight heads."
      },
      {
        "Component label": "A12",
        "Component": "Activation, positional encoding, normalization",
        "Status": "Follows",
        "Implemented detail": "SwiGLU expansion setting 4, rotary positions, RMSNorm, bfloat16 forward."
      },
      {
        "Component label": "A13",
        "Component": "Backbone numerical conventions",
        "Status": "Not Specified",
        "Implemented detail": "Weighted RMSNorm epsilon 1e-5; RoPE theta 10000; SwiGLU width 1536, rounded to 256; noncausal valid-key attention; bias-free projections."
      },
      {
        "Component label": "A14",
        "Component": "Inner recurrence",
        "Status": "Follows",
        "Implemented detail": "Four high cycles; two low calls then one high call per cycle; inputs injected into low calls; shared stack."
      },
      {
        "Component label": "A15",
        "Component": "Bounded, gated low updates",
        "Status": "Follows",
        "Implemented detail": "Per-token low-update relative bound .7, epsilon 1e-8; detached divisor; sigmoid scalar gate; post-cycle low/high normalization."
      },
      {
        "Component label": "A16",
        "Component": "Gate initialization",
        "Status": "Follows",
        "Implemented detail": "Scale low-gate weights by .1; zero bias."
      },
      {
        "Component label": "A17",
        "Component": "Gradient horizon",
        "Status": "Follows",
        "Implemented detail": "S22 retains final two high cycles and both low calls in each; earlier high-cycle ancestry detached."
      },
      {
        "Component label": "A18",
        "Component": "Indirect truncation semantics",
        "Status": "Not Specified",
        "Implemented detail": "Earlier calls use no_grad; boundary low/high detach; no derivative transport through unrecorded low calls."
      },
      {
        "Component label": "A19",
        "Component": "ACT and training depth",
        "Status": "Departs",
        "Implemented detail": "Fixed eight-step trajectories in the default recursive, shallower larger-batch, and sweep settings; fixed sixteen-step trajectories in both deeper larger-batch settings. No adaptive stopping."
      },
      {
        "Component label": "A20",
        "Component": "Halting head and losses",
        "Status": "Departs",
        "Implemented detail": "No Q-head or auxiliary halting losses; operator supervision only."
      },
      {
        "Component label": "A21",
        "Component": "Detached carry",
        "Status": "Follows",
        "Implemented detail": "Return detached low/high states and detach incoming carry between fixed recurrence optimizer updates."
      },
      {
        "Component label": "A22",
        "Component": "ACT clock, resets, and row replacement",
        "Status": "Not Specified",
        "Implemented detail": "One optimizer/EMA update per fixed recurrence step; recompute embeddings; hold whole batch for 8/16 steps; reset all slots together."
      },
      {
        "Component label": "A23",
        "Component": "Initial states and effective learning",
        "Status": "Departs",
        "Implemented detail": "Parameterized low/high initial vectors receive no gradients in S22; optimizer skips them, including weight decay."
      },
      {
        "Component label": "A24",
        "Component": "Other initialization",
        "Status": "Not Specified",
        "Implemented detail": "Linear/embedding truncated normals at 1/sqrt(width or fan-in), bounds ±2 SD; initial-state SD 1; norm weights 1; biases zero."
      },
      {
        "Component label": "A25",
        "Component": "Dropout placement and mask lifetime",
        "Status": "Follows",
        "Implemented detail": "Masks at listed sites, embeddings and states; state masks share token positions; reuse across all cycles and fixed recurrence steps of held trajectory."
      },
      {
        "Component label": "A26",
        "Component": "Arithmetic regularization settings",
        "Status": "Follows",
        "Implemented detail": "Core dropout .025; low/high dropout .010; no convolution; relative noise .005; low gate enabled."
      },
      {
        "Component label": "A27",
        "Component": "ACT-step Gaussian noise",
        "Status": "Follows",
        "Implemented detail": "Perturb embeddings and both states each fixed recurrence step with detached per-position norm times .005 times standard Gaussian noise."
      },
      {
        "Component label": "A28",
        "Component": "Random stream details",
        "Status": "Not Specified",
        "Implemented detail": "SHA256-keyed seed/trajectory/site draws; noise also keys fixed recurrence step; full-batch draws sliced across micro-batches."
      },
      {
        "Component label": "A29",
        "Component": "Supervised objective",
        "Status": "Follows",
        "Implemented detail": "Stablemax cross-entropy at masked operator positions."
      },
      {
        "Component label": "A30",
        "Component": "Stablemax map and reduction",
        "Status": "Not Specified",
        "Implemented detail": "Piecewise s(x)=x+1 for x≥0, 1/(1−x) otherwise; class normalization; valid-token-weighted mean; one global accumulation denominator."
      },
      {
        "Component label": "A31",
        "Component": "Optimizer family and betas",
        "Status": "Follows",
        "Implemented detail": "Adam-atan2; beta1 .9 and beta2 .95 as Table 6 specifies."
      },
      {
        "Component label": "A32",
        "Component": "Optimizer numerical constants and decay mechanics",
        "Status": "Not Specified",
        "Implemented detail": "a=1.27, b=1, bias-corrected moments; no additive epsilon; LR-scaled decoupled decay on parameters with gradients."
      },
      {
        "Component label": "A33",
        "Component": "Peak rate, floor, beta2, decay, puzzle rate",
        "Status": "Follows",
        "Implemented detail": "Peak 5e-4; floor .01 of peak; beta2 .95; weight decay 1.0. No puzzle-rate parameter group."
      },
      {
        "Component label": "A34",
        "Component": "Warm-up and clipping",
        "Status": "Follows",
        "Implemented detail": "2,000 effective-update warm-up; global norm clipping at 1 after accumulated backward calls."
      },
      {
        "Component label": "A35",
        "Component": "Schedule function and indexing",
        "Status": "Not Specified",
        "Implemented detail": "Linear warm-up from update one; cosine decay; completed schedules of 196,608, 38,912, or 155,648 updates."
      },
      {
        "Component label": "A36",
        "Component": "Physical batch and accumulation",
        "Status": "Departs",
        "Implemented detail": "Default recursive and sweep settings: physical/effective batch 1,024. Both deeper larger-batch schedules and their shallower counterpart: micro-batch 2,048 × 2, effective batch 4,096."
      },
      {
        "Component label": "A37",
        "Component": "Training length",
        "Status": "Departs",
        "Implemented detail": "Completed runs use 196,608, 38,912, or 155,648 updates; allocation caps and schedules define their endpoints."
      },
      {
        "Component label": "A38",
        "Component": "Seed and training-row order",
        "Status": "Departs",
        "Implemented detail": "All completed runs use seed 101; proposed additional seeds were superseded by the conditional sweep. Sampling uses permutations without replacement."
      },
      {
        "Component label": "A39",
        "Component": "EMA decay and evaluation weights",
        "Status": "Follows",
        "Implemented detail": "Decay .999; EMA evaluation weights."
      },
      {
        "Component label": "A40",
        "Component": "EMA initialization and update clock",
        "Status": "Not Specified",
        "Implemented detail": "Initialize EMA from model parameters; one lerp after each effective optimizer update."
      },
      {
        "Component label": "A41",
        "Component": "Full-budget evaluation and stochastic disabling",
        "Status": "Departs",
        "Implemented detail": "EMA reset-state inference at each recorded depth; primary eight or sixteen steps for recursive settings; one pass for controls; dropout/noise disabled."
      },
      {
        "Component label": "A42",
        "Component": "Exact metric and evaluation aggregation",
        "Status": "Not Specified",
        "Implemented detail": "Final-step canonical tuple equality; pool correct rows across strata; report selected best and final ID scores separately."
      },
      {
        "Component label": "A43",
        "Component": "Evaluation frequency and stopping",
        "Status": "Departs",
        "Implemented detail": "Every 2,048 updates on reused ID rows; threshold 1,844/2,048; bounded allocation and schedule stops; FLAT diagnostic after continuation."
      },
      {
        "Component label": "A44",
        "Component": "Puzzle embeddings",
        "Status": "Departs",
        "Implemented detail": "No puzzle-identity table or sign-SGD group; paper Arithmetic Puzzle LR .005 has no corresponding parameter."
      },
      {
        "Component label": "A45",
        "Component": "Forward and loss precision",
        "Status": "Not Specified",
        "Implemented detail": "Bfloat16 forward; FP32 master parameters, norm/bound/attention reductions; FP64 stablemax loss; CPU train-fit checks FP32."
      }
    ]
  },
